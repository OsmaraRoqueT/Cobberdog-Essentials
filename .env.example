# Optional: bake household sync settings into the build.
# The anon key is safe to ship in a browser app; Row Level Security protects the data.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Optional: Maps Embed API key (browser key, restricted to your site) for maps in the vet finder.
VITE_GOOGLE_MAPS_EMBED_KEY=
